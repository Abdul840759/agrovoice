PORT=4000
# Set this to the deployed Vercel origin on Render, e.g. https://agrovoice.vercel.app
CORS_ORIGIN=
# Generate a unique secret with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Production providers. All keys below are required for the full voice workflow.
AI_STT=elevenlabs
AI_ADVISOR=claude
AI_TTS=9jalingo
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
NAIJALINGO_API_KEY=
NAIJALINGO_SPEAKER=aisha_ha
